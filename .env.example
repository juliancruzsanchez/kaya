# ─────────────────────────────────────────────────────────────
# Kaya — copy to .env and fill in what you need.
# Everything here is optional except MINIMAX_API_KEY if you use M3.1-Flash.
# Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── LLM ──────────────────────────────────────────────────────
# MiniMax M3.1-Flash-Preview (has tool calling, OpenAI-compatible)
MINIMAX_API_KEY=
KAYA_LLM_PROVIDER=openai-compat
KAYA_LLM_BASE_URL=https://api.minimax.io/v1
KAYA_LLM_MODEL=MiniMax-M3.1-Flash-Preview
# low | medium | high | xhigh | max  — M3.1-Flash always thinks and
# defaults to max, which is far too slow for a voice assistant.
KAYA_LLM_REASONING_EFFORT=low

# ── TTS ──────────────────────────────────────────────────────
# edge = free, no key, default. Also: openai | elevenlabs | minimax
KAYA_TTS_PROVIDER=edge
KAYA_TTS_VOICE=en-US-AriaNeural
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
MINIMAX_TTS_MODEL=speech-2.8-turbo

# ── STT ──────────────────────────────────────────────────────
# local  = whisper.cpp spawned on this Pi (offline, ~1-2s, uses CPU)
# remote = whisper-server on a LAN box (fast, Pi stays idle)
# openai / elevenlabs also available
# Switchable at runtime from the dashboard - no restart needed.
KAYA_STT_PROVIDER=remote
# used when KAYA_STT_PROVIDER=remote
KAYA_STT_URL=http://whisper.local:8080/inference
# used when KAYA_STT_PROVIDER=local
KAYA_STT_BIN=/usr/local/bin/whisper-cli
KAYA_STT_MODEL=tiny.en
KAYA_STT_MODEL_DIR=/dev/shm/kaya-models
KAYA_STT_THREADS=3

# ── Wake word ────────────────────────────────────────────────
# Free AccessKey from https://console.picovoice.ai/
PICOVOICE_ACCESS_KEY=
KAYA_WAKE_PHRASE=Hey Kaya
KAYA_WAKE_SENSITIVITY=0.55
KAYA_WAKE_KEYWORD=assets/hey_kaya_raspberry-pi.ppn

# ── Audio (PiSugar Whisplay HAT) ────────────────────────────
KAYA_AUDIO_INPUT=plughw:whisplaysound,0
KAYA_AUDIO_OUTPUT=plughw:whisplaysound,0
KAYA_AUDIO_GAIN=1.6

# ── Web search (first available wins) ────────────────────────
# responses (OpenAI) | parallel (free, no key) | tavily
KAYA_SEARCH_PROVIDER=parallel
TAVILY_API_KEY=

# ── Server ───────────────────────────────────────────────────
KAYA_PORT=8080
KAYA_HOST=0.0.0.0
